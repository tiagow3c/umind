{
  "version": 1,
  "sdk_version": "3.2.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://fieylryuydhyakdplmcl.supabase.co/auth/v1",
    "require_oauth_client_claim": true,
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "umind",
      "version": "0.1.0",
      "title": "Umind"
    },
    "tools": [
      {
        "name": "list_meetings",
        "title": "Listar reuniões",
        "description": "Lista as reuniões mais recentes que o usuário pode ver no Ata, com título, data, estado e origem.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "Quantidade máxima de reuniões (1 a 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_meeting",
        "title": "Detalhes da reunião",
        "description": "Retorna o resumo, os participantes e a transcrição de uma reunião do Ata pelo seu ID.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "meeting_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "ID da reunião (vem de list_meetings ou search_meetings)."
            }
          },
          "required": [
            "meeting_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "search_meetings",
        "title": "Buscar nas reuniões",
        "description": "Busca semântica por assunto nas transcrições e nos itens de análise das reuniões que o usuário pode ver.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 2,
              "maxLength": 500,
              "description": "Assunto ou pergunta a buscar, em linguagem natural."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_tasks",
        "title": "Listar tarefas",
        "description": "Lista as tarefas do usuário no Ata, com filtro por estado (abertas, concluídas ou todas).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "status": {
              "default": "open",
              "description": "Filtrar por estado: open, done ou all.",
              "type": "string",
              "enum": [
                "open",
                "done",
                "all"
              ]
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
